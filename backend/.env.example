PORT=5000
EXPO_PUBLIC_BACKEND_URL=your_backend_url_here

# Firebase Admin SDK service account.
# Path relative to the backend/ directory. Download per Section 3.2 of the
# team Local Development Setup Guide (Firebase Console → Project Settings →
# Service Accounts → Generate new private key → save as serviceAccount.json).
# The same service account is also used for Google Cloud Vision API calls,
# so it needs a Cloud Vision IAM role granted in Google Cloud Console.
# See docs/vision-api-setup.md for the full GCP setup steps.
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json

# SCRUM-187: Google Cloud Vision credentials for /api/scan.
# By default, GOOGLE_APPLICATION_CREDENTIALS above is used to authenticate
# Vision API calls (same service account as Firebase Admin). For deploys
# where mounting a JSON file is awkward (Render, Heroku, etc.), set
# GCV_CREDENTIALS_BASE64 instead — base64-encoded contents of the same
# service account JSON.
# If neither is set, /api/scan falls back to MOCK mode (canned OCR output)
# so local dev still works without GCP credentials.
# GCV_CREDENTIALS_BASE64=

# SCRUM-187: Optional. Disable the Firestore caching layer for the
# CocktailDB ingredient vocabulary. Useful in tests or when running
# without Firebase project access.
# SCAN_DISABLE_FIRESTORE_CACHE=true

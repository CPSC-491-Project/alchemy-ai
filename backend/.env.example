PORT=5000
GOOGLE_APPLICATION_CREDENTIALS=path/to/serviceAccount.json
EXPO_PUBLIC_BACKEND_URL=your_backend_url_here

# SCRUM-187: Google Cloud Vision credentials for /api/scan.
# Set EITHER GCV_CREDENTIALS_BASE64 (base64-encoded service-account JSON,
# convenient for Render/Heroku-style deploys) OR rely on the standard
# GOOGLE_APPLICATION_CREDENTIALS above to point at a local JSON file.
# If neither is set, /api/scan falls back to MOCK mode (canned OCR output).
# GCV_CREDENTIALS_BASE64=
